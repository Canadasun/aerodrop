<?xml version="1.0"?>
<sdf version="1.8">
  <world name="calgary_suburb">
    <!-- PX4 waits for SceneBroadcaster's /world/<name>/scene/info service. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>0.000015 0.000002 -0.000050</magnetic_field>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>51.115</latitude_deg>
      <longitude_deg>-114.110</longitude_deg>
      <elevation>1045</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <!-- 10 m/s flow from west to east, used as a steady wind disturbance. -->
    <wind>
      <linear_velocity>10 0 0</linear_velocity>
    </wind>
    <plugin filename="gz-sim-wind-effects-system" name="gz::sim::systems::WindEffects">
      <force_approximation_scaling_factor>0.02</force_approximation_scaling_factor>
      <horizontal>
        <magnitude>
          <time_for_rise>2</time_for_rise>
          <sin><amplitude_percent>0.15</amplitude_percent><period>6</period></sin>
          <noise>0.1</noise>
        </magnitude>
        <direction>
          <time_for_rise>2</time_for_rise>
          <sin><amplitude>0.12</amplitude><period>7</period></sin>
          <noise>0.04</noise>
        </direction>
      </horizontal>
    </plugin>
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.8 0.88 0.96 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>5000 5000</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>5000 5000</size></plane></geometry><material><ambient>0.25 0.32 0.25 1</ambient><diffuse>0.3 0.38 0.3 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
